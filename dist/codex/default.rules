    decision = "prompt",
    justification = "Opens a tunnel into the cluster or copies files across the boundary.",
)

prefix_rule(
    pattern = ["helm", "upgrade"],
    decision = "prompt",
    justification = "Changes what is running, but through a reviewable release or reconciliation.",
)

prefix_rule(
    pattern = ["argocd", "app", "sync"],
    decision = "prompt",
    justification = "Changes what is running, but through a reviewable release or reconciliation.",
)

prefix_rule(
    pattern = ["flux", "reconcile"],
    decision = "prompt",
    justification = "Changes what is running, but through a reviewable release or reconciliation.",
)

prefix_rule(
    pattern = ["kubectl", ["delete", "apply", "replace", "patch", "edit", "scale", "drain", "cordon", "taint", "create"]],
    decision = "forbidden",
    justification = "Mutating verbs against a live cluster. There is no local undo for any of them.",
)

prefix_rule(
    pattern = ["kubectl", "rollout", "undo"],
    decision = "forbidden",
    justification = "Mutating verbs against a live cluster. There is no local undo for any of them.",
)

prefix_rule(
    pattern = ["kubectl", ["exec", "attach"]],
    decision = "forbidden",
    justification = "A shell in a pod is a shell, with that pod's service account and network position.",
)

prefix_rule(
    pattern = ["kubectl", "config", "use-context"],
    decision = "forbidden",
    justification = "Silently repoints every later command at a different cluster.",
)

prefix_rule(
    pattern = ["kubectl", "config", "set"],
    decision = "forbidden",
    justification = "Silently repoints every later command at a different cluster.",
)

prefix_rule(
