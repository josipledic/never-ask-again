# Generated by scripts/build.py from rules/*.toml. Do not edit by hand.
# https://github.com/josipledic/never-ask-again
#
# decision = "allow"     -> run without prompting
# decision = "prompt"    -> ask every time
# decision = "forbidden" -> block without prompting
#
# Most restrictive match wins: forbidden > prompt > allow.
#
# Test before trusting:
#   codex execpolicy check --pretty --rules ~/.codex/rules/default.rules -- git add .

# -------------------------------------------------------------------------
# core: Tool-level rules, secret files, and the deny block that applies to every stack
# -------------------------------------------------------------------------

prefix_rule(
    pattern = [["brew", "apt", "apt-get"]],
    decision = "prompt",
    justification = "Installs software machine-wide and runs vendor scripts as you.",
)

prefix_rule(
    pattern = [["sudo", "doas", "su"]],
    decision = "forbidden",
    justification = "Privilege escalation. Nothing an agent does should need root.",
)

prefix_rule(
    pattern = [["rmdir", "shred"]],
    decision = "forbidden",
    justification = "Recursive or raw deletion with no undo.",
)

prefix_rule(
    pattern = ["rm", ["-rf", "-fr", "-r"]],
    decision = "forbidden",
    justification = "Recursive or raw deletion with no undo.",
)

prefix_rule(
    pattern = [["dd", "mkfs", "diskutil", "fdisk"]],
    decision = "forbidden",
    justification = "Writes raw blocks or repartitions disks.",
)

prefix_rule(
    pattern = ["chown"],
    decision = "forbidden",
    justification = "Changes ownership or opens permissions across a tree.",
)

prefix_rule(
    pattern = ["chmod", ["777", "-R"]],
    decision = "forbidden",
    justification = "Changes ownership or opens permissions across a tree.",
)

prefix_rule(
    pattern = [["curl", "wget", "nc", "ncat", "socat"]],
    decision = "forbidden",
    justification = "Arbitrary network I/O is the exfiltration path. Use the fetch tool, which is logged.",
)

prefix_rule(
    pattern = [["ssh", "scp", "rsync", "sftp", "ssh-keygen", "ssh-add"]],
    decision = "forbidden",
    justification = "Moves data or executes on other machines, outside anything this policy can see.",
)

prefix_rule(
    pattern = [["gpg", "pass", "security", "keychain", "op", "vault"]],
    decision = "forbidden",
    justification = "Credential stores. Reading one is the same as leaking it.",
)

prefix_rule(
    pattern = [["eval", "exec", "source", "osascript"]],
    decision = "forbidden",
    justification = "Executes a constructed string, which defeats every rule above it.",
)

prefix_rule(
    pattern = ["bash", "-c"],
    decision = "forbidden",
    justification = "Executes a constructed string, which defeats every rule above it.",
)

prefix_rule(
    pattern = ["sh", "-c"],
    decision = "forbidden",
    justification = "Executes a constructed string, which defeats every rule above it.",
)

prefix_rule(
    pattern = ["zsh", "-c"],
    decision = "forbidden",
    justification = "Executes a constructed string, which defeats every rule above it.",
)

prefix_rule(
    pattern = [["launchctl", "systemctl", "service", "crontab", "at"]],
    decision = "forbidden",
    justification = "Starts, stops or schedules background work that outlives the session.",
)

prefix_rule(
    pattern = [["killall", "pkill", "shutdown", "reboot"]],
    decision = "forbidden",
    justification = "Kills processes the agent did not start, or takes the machine down.",
)

prefix_rule(
    pattern = ["kill", "-9"],
    decision = "forbidden",
    justification = "Kills processes the agent did not start, or takes the machine down.",
)

prefix_rule(
    pattern = ["defaults", "write"],
    decision = "forbidden",
    justification = "Rewrites macOS defaults for other applications.",
)

prefix_rule(
    pattern = ["xargs", "rm"],
    decision = "forbidden",
    justification = "find running a command per match is an arbitrary execution primitive.",
)

# not expressible in Codex (embedded wildcard): find * -delete *
# not expressible in Codex (embedded wildcard): find * -exec *

prefix_rule(
    pattern = ["history", "-c"],
    decision = "forbidden",
    justification = "Covers the agent's tracks.",
)

prefix_rule(
    pattern = [["claude", "codex", "opencode", "omp", "droid", "cursor-agent"]],
    decision = "forbidden",
    justification = "A nested agent starts with its own permission set, not this one.",
)

# -------------------------------------------------------------------------
# version control: git, jujutsu, and commit hooks
# -------------------------------------------------------------------------

prefix_rule(
    pattern = ["git", ["add", "commit", "switch", "checkout", "branch", "fetch", "stash", "worktree", "rebase", "bisect", "notes"]],
    decision = "allow",
    justification = "Local and reversible. Anything these touch is recoverable from the reflog.",
)

prefix_rule(
    pattern = ["git", "pull", "--ff-only"],
    decision = "allow",
    justification = "Local and reversible. Anything these touch is recoverable from the reflog.",
)

prefix_rule(
    pattern = ["git", "merge", "--abort"],
    decision = "allow",
    justification = "Local and reversible. Anything these touch is recoverable from the reflog.",
)

prefix_rule(
    pattern = ["git", "cherry-pick", "--abort"],
    decision = "allow",
    justification = "Local and reversible. Anything these touch is recoverable from the reflog.",
)

prefix_rule(
    pattern = ["git", "revert", "--abort"],
    decision = "allow",
    justification = "Local and reversible. Anything these touch is recoverable from the reflog.",
)

prefix_rule(
    pattern = ["git", ["blame", "describe", "rev-parse", "ls-files", "shortlog", "range-diff", "tag"]],
    decision = "allow",
    justification = "Read-only inspection.",
)

prefix_rule(
    pattern = ["git", "lfs", "ls-files"],
    decision = "allow",
    justification = "Read-only inspection.",
)

prefix_rule(
    pattern = ["git", "remote", "-v"],
    decision = "allow",
    justification = "Read-only inspection.",
)

prefix_rule(
    pattern = ["git", "submodule", "status"],
    decision = "allow",
    justification = "Read-only inspection.",
)

prefix_rule(
    pattern = ["jj", ["log", "diff", "describe", "new", "squash", "rebase", "status"]],
    decision = "allow",
    justification = "Jujutsu keeps an operation log, so every one of these is undoable with jj undo.",
)

prefix_rule(
    pattern = ["gitleaks", ["detect", "protect"]],
    decision = "allow",
    justification = "Runs the hooks the repository already committed to running.",
)

prefix_rule(
    pattern = ["pre-commit", "run"],
    decision = "allow",
    justification = "Runs the hooks the repository already committed to running.",
)

prefix_rule(
    pattern = ["lefthook", "run"],
    decision = "allow",
    justification = "Runs the hooks the repository already committed to running.",
)

prefix_rule(
    pattern = ["commitlint"],
    decision = "allow",
    justification = "Runs the hooks the repository already committed to running.",
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Publishes to a shared remote or rewrites a commit others may already have.",
)

prefix_rule(
    pattern = ["git", "commit", "--amend"],
    decision = "prompt",
    justification = "Publishes to a shared remote or rewrites a commit others may already have.",
)

prefix_rule(
    pattern = ["git", "tag", "-d"],
    decision = "prompt",
    justification = "Publishes to a shared remote or rewrites a commit others may already have.",
)

prefix_rule(
    pattern = ["git", "remote", "add"],
    decision = "prompt",
    justification = "Publishes to a shared remote or rewrites a commit others may already have.",
)

prefix_rule(
    pattern = ["git", "submodule", "update"],
    decision = "prompt",
    justification = "Publishes to a shared remote or rewrites a commit others may already have.",
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Rewrites shared history. Run --force-with-lease yourself if you mean it.",
)

prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "forbidden",
    justification = "Rewrites shared history. Run --force-with-lease yourself if you mean it.",
)

prefix_rule(
    pattern = ["git", "push", "--mirror"],
    decision = "forbidden",
    justification = "Rewrites shared history. Run --force-with-lease yourself if you mean it.",
)

prefix_rule(
    pattern = ["git", "push", "--delete"],
    decision = "forbidden",
    justification = "Rewrites shared history. Run --force-with-lease yourself if you mean it.",
)

prefix_rule(
    pattern = ["git", "restore"],
    decision = "forbidden",
    justification = "Destroys uncommitted work. There is no reflog for something never committed.",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Destroys uncommitted work. There is no reflog for something never committed.",
)

prefix_rule(
    pattern = ["git", "clean", "-f"],
    decision = "forbidden",
    justification = "Destroys uncommitted work. There is no reflog for something never committed.",
)

prefix_rule(
    pattern = ["git", "clean", "-x"],
    decision = "forbidden",
    justification = "Destroys uncommitted work. There is no reflog for something never committed.",
)

prefix_rule(
    pattern = ["git", "checkout", "--"],
    decision = "forbidden",
    justification = "Destroys uncommitted work. There is no reflog for something never committed.",
)

prefix_rule(
    pattern = ["git", ["filter-branch", "filter-repo"]],
    decision = "forbidden",
    justification = "Rewrites or prunes history beyond recovery.",
)

prefix_rule(
    pattern = ["git", "reflog", "delete"],
    decision = "forbidden",
    justification = "Rewrites or prunes history beyond recovery.",
)

prefix_rule(
    pattern = ["git", "gc", "--prune"],
    decision = "forbidden",
    justification = "Rewrites or prunes history beyond recovery.",
)

prefix_rule(
    pattern = ["git", "update-ref", "-d"],
    decision = "forbidden",
    justification = "Rewrites or prunes history beyond recovery.",
)

prefix_rule(
    pattern = ["git", "branch", "-D"],
    decision = "forbidden",
    justification = "Rewrites or prunes history beyond recovery.",
)

prefix_rule(
    pattern = ["git", "config", "--global"],
    decision = "forbidden",
    justification = "Changes git behaviour outside this repository, or redirects git to another binary.",
)

prefix_rule(
    pattern = ["git", "config", "--system"],
    decision = "forbidden",
    justification = "Changes git behaviour outside this repository, or redirects git to another binary.",
)

