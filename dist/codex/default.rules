    pattern = ["gh", "repo", "delete"],
    decision = "forbidden",
    justification = "Deletes or archives a repository, or publishes a release. None of it is undoable.",
)

prefix_rule(
    pattern = ["gh", "repo", "archive"],
    decision = "forbidden",
    justification = "Deletes or archives a repository, or publishes a release. None of it is undoable.",
)

prefix_rule(
    pattern = ["gh", "api", "-X", "DELETE"],
    decision = "forbidden",
    justification = "Raw API calls with a write method bypass every other gh rule above.",
)

prefix_rule(
    pattern = ["gh", "api", "--method", "DELETE"],
    decision = "forbidden",
    justification = "Raw API calls with a write method bypass every other gh rule above.",
)

