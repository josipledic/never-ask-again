)

prefix_rule(
    pattern = ["aws", "sts", "get-caller-identity"],
    decision = "allow",
    justification = "AWS read verbs. describe, list and get never change anything.",
)

# not expressible in Codex (embedded wildcard): aws * describe-* *
# not expressible in Codex (embedded wildcard): aws * list-* *
# not expressible in Codex (embedded wildcard): aws * get-* *

prefix_rule(
    pattern = ["gcloud", "config", "list"],
