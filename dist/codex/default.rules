    justification = "Raw API calls with a write method bypass every other gh rule above.",
)

# -------------------------------------------------------------------------
# publishing: Every package registry, denied without exception
# -------------------------------------------------------------------------

prefix_rule(
    pattern = ["npm", "publish"],
    decision = "forbidden",
    justification = "Publishes to a public registry. Once a version number is taken it is taken forever.",
)

