# -------------------------------------------------------------------------

prefix_rule(
    pattern = [["rg", "fd", "jq", "gojq", "yq", "sd", "delta", "difft", "tokei", "scc", "hyperfine", "jless", "mlr", "xsv", "bat", "eza", "tree"]],
    decision = "allow",
    justification = "Search and structured data tools. They read and print.",
)

