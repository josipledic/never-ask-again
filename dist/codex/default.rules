    pattern = ["glab", "token"],
    decision = "forbidden",
    justification = "Reads or writes CI secrets and auth tokens. Printing one to the transcript leaks it.",
)

prefix_rule(
    pattern = ["gh", "release", "create"],
    decision = "forbidden",
    justification = "Deletes or archives a repository, or publishes a release. None of it is undoable.",
)

prefix_rule(
    pattern = ["gh", "release", "delete"],
    decision = "forbidden",
    justification = "Deletes or archives a repository, or publishes a release. None of it is undoable.",
)

