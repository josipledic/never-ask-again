    decision = "allow",
    justification = "AWS read verbs. describe, list and get never change anything.",
)

prefix_rule(
    pattern = ["aws", "cloudformation", "validate-template"],
    decision = "allow",
    justification = "AWS read verbs. describe, list and get never change anything.",
)

