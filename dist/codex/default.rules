)

prefix_rule(
    pattern = ["argocd", "app", "delete"],
    decision = "forbidden",
    justification = "Installs, removes or rolls back releases and controllers.",
)

prefix_rule(
    pattern = ["argocd", "app", "rollback"],
    decision = "forbidden",
    justification = "Installs, removes or rolls back releases and controllers.",
)

prefix_rule(
    pattern = ["flux", ["suspend", "uninstall"]],
